rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sales.infarmatik.tj@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /userData/{userId} {
      allow read, delete: if isOwner(userId) || isAdmin();

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['snapshot', 'version', 'updatedAt'])
        && request.resource.data.snapshot is string
        && request.resource.data.snapshot.size() <= 850000
        && request.resource.data.version == 1
        && request.resource.data.updatedAt == request.time;
    }


    match /userProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'email', 'provider', 'createdAt', 'lastLoginAt'])
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      // Exact username lookup is required before Firebase Authentication signs in.
      // Collection listing remains admin-only; salary data is stored elsewhere.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /kitchen/{documentId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy', 'shiftName'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 300
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /kitchenShifts/{shiftId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['items', 'createdAt', 'createdBy', 'shiftName', 'missingCount'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
